# 4000 so it doesn't clash with the Next.js web app on 3000
PORT=4000
# Exact origin of the web app, allowed by CORS with credentials
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=ticket_booking
DB_PASSWORD=ticket_booking
DB_NAME=ticket_booking
DB_SYNCHRONIZE=false
# true = apply pending migrations when the app boots (dev convenience)
DB_MIGRATIONS_RUN=false
# Hosted Postgres (e.g. Neon). If set, overrides the DB_* values above.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ticket-booking-api
JWT_AUDIENCE=ticket-booking

# Refresh tokens / sessions
# HMAC key for refresh-token hashes. Generate with: openssl rand -base64 48
REFRESH_TOKEN_PEPPER=change-me-to-at-least-32-random-characters
# Refresh token dies if unused this long (7 days)
REFRESH_TOKEN_IDLE_TTL_SECONDS=604800
# Session dies this long after login, however active (30 days)
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Cookies. Keep true everywhere except local plain-http dev.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Email / phone verification codes
# HMAC key for OTP hashes. Generate with: openssl rand -base64 48
VERIFICATION_CODE_PEPPER=change-me-to-at-least-32-random-characters
# SMTP. Dev: Mailpit from docker-compose (web inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=Balcony <no-reply@balcony.local>
